{
  "name": "the-quest",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:sql": "vitest run tests/sql",
    "test:sql:pg": "node scripts/test-sql-real-pg.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run test:sql:pg && npm run build && npm run test:e2e",
    "package": "npm run build && node scripts/package.mjs",
    "serve:e2e": "node tests/e2e/server.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@eslint/js": "^9.39.5",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.1.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "5.7",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
